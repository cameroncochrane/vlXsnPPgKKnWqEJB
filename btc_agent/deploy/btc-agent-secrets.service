[Unit]
Description=Fetch btc-agent secrets from SSM Parameter Store
After=network-online.target
Wants=network-online.target
Before=btc-agent.service btc-agent-app.service

[Service]
Type=oneshot
# Runs as root, using the copy of fetch_secrets.sh installed to /usr/local/sbin (README step 5), so it doesn't depend on
# where the repo is cloned and only changes when the script is deliberately reinstalled
ExecStart=/usr/local/sbin/btc-agent-fetch-secrets
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
