{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBtcAgentParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:*:*:parameter/btc-agent",
        "arn:aws:ssm:*:*:parameter/btc-agent/*"
      ]
    },
    {
      "Sid": "DecryptBtcAgentParameters",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "kms:ViaService": "ssm.*.amazonaws.com"
        }
      }
    }
  ]
}
